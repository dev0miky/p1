<configuration name="switch.conf" description="Core Configuration">
  <cli-keybindings>
    <key name="1" value="help"/>
    <key name="2" value="status"/>
    <key name="3" value="show channels"/>
    <key name="4" value="show calls"/>
    <key name="5" value="sofia status"/>
    <key name="6" value="reloadxml"/>
  </cli-keybindings>

  <default-ptimes/>

  <settings>
    <param name="colorize-console" value="false"/>
    <param name="max-sessions" value="5000"/>
    <param name="sessions-per-second" value="100"/>
    <param name="loglevel" value="info"/>
    <param name="rtp-start-port" value="16384"/>
    <param name="rtp-end-port" value="32768"/>
    <param name="rtp-enable-zrtp" value="false"/>
    <param name="run-as-user" value="freeswitch"/>
    <param name="run-as-group" value="freeswitch"/>
    <param name="enable-monotonic-timing" value="true"/>
    <param name="enable-clock-nanosleep" value="true"/>
    <param name="initial-event-threads" value="2"/>
  </settings>
</configuration>
