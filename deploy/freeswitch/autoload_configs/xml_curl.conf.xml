<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <bindings>
    <binding name="configuration">
      <!-- engine /fs/xml: Basic auth, empty user, secret as password -->
      <param name="gateway-url" value="http://127.0.0.1:8080/fs/xml" bindings="configuration"/>
      <param name="gateway-credentials" value=":$${fs_xml_curl_secret}"/>
      <param name="method" value="POST"/>
    </binding>
  </bindings>
</configuration>
